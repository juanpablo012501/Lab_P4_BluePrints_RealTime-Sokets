PORT=3001
# Orígenes permitidos (separados por coma). En producción, solo tu dominio.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# API Spring (P3) usada para autorizar el acceso a cada plano con el JWT del usuario
API_BASE=http://localhost:8080
# true = exige JWT y verifica contra la API al hacer join-room. false = modo abierto (solo para pruebas)
REQUIRE_AUTH=true
